{
  "name": "exporters",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/exporters/src",
  "projectType": "library",
  "implicitDependencies": ["geometry-engine"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run build -w @slablab/exporters" },
      "outputs": ["{workspaceRoot}/dist/exporters"]
    },
    "test": { "executor": "nx:run-commands", "options": { "command": "vitest run packages/exporters" } },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint packages/exporters/src --max-warnings=0" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p packages/exporters/tsconfig.json --noEmit" }
    }
  },
  "tags": ["type:library", "platform:browser"]
}
